# ==========================================
# CodeMentor AI - Root Environment Config
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codementor
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codementor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Backend Server
PORT=5000
NODE_ENV=development
JWT_SECRET=codementor-super-secure-jwt-secret-key-32chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# AI Engine (Optional Gemini / OpenAI / Anthropic key; Socratic heuristic fallback works without it)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Execution Judge
ENABLE_DOCKER_JUDGE=true
JUDGE_TIMEOUT_MS=3000
JUDGE_MEMORY_LIMIT_MB=128
